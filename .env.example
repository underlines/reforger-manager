# Reforger Manager — environment
#
# Copy to .env (for `docker compose` / local dev) or paste the values into your
# deployment's env mechanism (e.g. Portainer stack "Environment variables").
# Every var below is read by docker-compose.yml via ${VAR} interpolation; the
# ones marked REQUIRED have no default and the stack refuses to start without
# them.
#
# ---------------------------------------------------------------------------
# No Steam account / Steam Guard / 2FA anywhere in this project.
# Arma Reforger Server (Steam app 1874900) installs and updates with
#   steamcmd +login anonymous +app_update 1874900 validate
# There is no credential path to configure.
# ---------------------------------------------------------------------------

# --- Host data location ---------------------------------------------------------
# Absolute host path holding the bind-mounted persistent data: Reforger install
# (~10 GB), addon cache (tens of GB), Postgres. Defaults to ./data (fine for
# local dev only). On a server, ALWAYS set this to a real path with room, e.g.
# /opt/reforger-manager/data or /mnt/apps/reforger-manager.
DATA_DIR=./data

# --- Postgres ---
POSTGRES_USER=reforger
POSTGRES_PASSWORD=change-me-24-plus-url-safe-chars      # REQUIRED
POSTGRES_DB=reforger_manager
POSTGRES_VERSION=17

# SQLAlchemy async DSN used by the app. Leave unset to have docker-compose.yml
# build it from the POSTGRES_* values above against 127.0.0.1:5432 (correct for
# the default host-networked deployment). Set explicitly only if the DB is
# elsewhere. The local-dev override always points it at host.docker.internal.
# DATABASE_URL=postgresql+asyncpg://reforger:change-me@127.0.0.1:5432/reforger_manager

# --- Auth ---
JWT_SECRET=change-me-48-plus-random-chars               # REQUIRED (rotating invalidates all sessions)
JWT_EXPIRE_HOURS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-20-plus-chars                  # REQUIRED (used once to create the admin on an empty DB; change it in the UI after)

# --- Behaviour (optional; sensible defaults) ---
TZ=UTC
# Schema bootstrap on startup: "create_all" (default, no tooling) or "alembic".
DB_MIGRATE_ON_STARTUP=create_all
# Reforger engine build check (api.steamcmd.net) on startup.
ENGINE_CHECK_ON_STARTUP=true
# Optional nightly engine/mod metadata check. Disabled unless explicitly enabled.
NIGHTLY_CHECK_ENABLED=false
NIGHTLY_CHECK_HOUR=3
# Profile-files editor: files at/under this size are text-editable in the UI; larger ones are download-only.
FILES_MAX_EDIT_BYTES=2097152
# Profile-files editor: uploads larger than this (bytes) are rejected with HTTP 413.
FILES_MAX_UPLOAD_BYTES=50000000
# CORS allow-list (JSON array). The SPA is served same-origin by FastAPI, so
# this only matters for the Vite dev server and other cross-origin callers. Keep
# http://localhost:5173 or `npm run dev` breaks; add your externally served
# origin, e.g. ["https://reforger.example.com","http://localhost:5173"].
CORS_ORIGINS=["http://localhost:5173"]

# --- Advanced / rarely changed ---
# COMPOSE_PROJECT_NAME=reforger-manager   # container + network name prefix
# RESTART_POLICY=unless-stopped
# DB_BIND_ADDR=127.0.0.1                  # host addr the db port is published on
# DB_PORT=5432                            # host port the db is published on
