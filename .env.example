# Reforger Manager — environment (copy to .env and fill in real values)
#
# ---------------------------------------------------------------------------
# No Steam account / Steam Guard / 2FA anywhere in this project.
# Arma Reforger Server (Steam app 1874900) installs and updates with
#   steamcmd +login anonymous +app_update 1874900 validate
# There is no credential path to configure.
# ---------------------------------------------------------------------------

# Timezone (used by the container and by scheduled jobs)
TZ=UTC

# --- Host data location -----------------------------------------------------
# Where the bind-mounted persistent data lives on the host: Reforger install
# (~10 GB), addon cache (tens of GB), Postgres data. Default is ./data in the
# repo; point it at a roomy path for production.
DATA_DIR=./data

# --- Postgres 17 (reforger-manager-db) ---
POSTGRES_USER=reforger
POSTGRES_PASSWORD=change-me-24-plus-url-safe-chars
POSTGRES_DB=reforger_manager

# SQLAlchemy async DSN. In the base (host-networked) setup the manager reaches
# the db over the published 127.0.0.1:5432 mapping, so host = localhost. The
# local dev override rewrites the host to host.docker.internal. Keep
# user/pass/db in sync with the POSTGRES_* values above; the password must be
# URL-safe.
DATABASE_URL=postgresql+asyncpg://reforger:change-me-24-plus-url-safe-chars@localhost:5432/reforger_manager

# --- Auth ---
# JWT signing secret (48+ chars). Rotating this invalidates all sessions.
JWT_SECRET=change-me-48-plus-random-chars
# First-run bootstrap admin. Created once on an empty DB; change the password
# from the UI afterwards. Later runs ignore these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-20-plus-chars

# --- Steam / engine ---
STEAM_APP_ID=1874900

# --- Ports ---
# Web UI / API. In the local dev override this is the published host port; put a
# reverse proxy in front for TLS if you expose it.
WEB_PORT=18090
# Default RCON port written into generated server configs.
RCON_DEFAULT_PORT=19999

# --- In-container paths (bind mounts; do not change without matching compose) ---
SERVER_DIR=/home/steam/data/server
MODS_DIR=/home/steam/data/mods
PROFILES_DIR=/home/steam/data/profiles
CONFIGS_DIR=/home/steam/data/configs

# --- Backend behaviour (optional; sensible defaults) ---
# Schema bootstrap on startup: "create_all" (default, no tooling) or "alembic".
DB_MIGRATE_ON_STARTUP=create_all
# Run a Reforger engine build check (api.steamcmd.net) on startup.
ENGINE_CHECK_ON_STARTUP=true
# Optional nightly engine/mod metadata check. Disabled unless explicitly enabled.
NIGHTLY_CHECK_ENABLED=false
NIGHTLY_CHECK_HOUR=3
NIGHTLY_CHECK_INTERVAL_SECONDS=86400
# JWT lifetime.
JWT_EXPIRE_HOURS=12
# CORS allow-list (JSON array). The SPA is served same-origin by FastAPI, so
# this only matters for the Vite dev server and other cross-origin callers. Keep
# http://localhost:5173 or `npm run dev` breaks; add your externally served
# origin (e.g. "https://reforger.example.com") if the UI is reached cross-origin.
CORS_ORIGINS=["http://localhost:5173"]
